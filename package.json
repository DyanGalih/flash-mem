{
  "name": "flash-mem",
  "version": "1.0.0",
  "license": "MIT",
  "description": "MCP Server for durable engineering memory in AI-assisted software development",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "flash-mem": "dist/infrastructure/cli/index.js"
  },
  "files": [
    "dist",
    "docs/cli-reference.md",
    "docs/flash-mem-review-prompt.md",
    "docs/mcp-setup.md",
    "docs/releases.md",
    "docs/spec-kit-integration.md",
    "docs/tool-surface.md",
    "docs/usage.md",
    "vendor/modelcontextprotocol-sdk",
    "README.md"
  ],
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/infrastructure/cli/index.js",
    "mcp": "node dist/infrastructure/cli/index.js mcp",
    "release:patch": "npm run build && npm run test && npm version patch && git push && git push --tags && npm publish",
    "release:minor": "npm run build && npm run test && npm version minor && git push && git push --tags && npm publish",
    "release:major": "npm run build && npm run test && npm version major && git push && git push --tags && npm publish"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "file:./vendor/modelcontextprotocol-sdk",
    "@toon-format/toon": "^4.1.1",
    "better-sqlite3": "^13.0.3",
    "commander": "^12.0.0",
    "fs-extra": "^11.2.0",
    "zod": "^3.23.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.12.0",
    "typescript": "^5.4.0",
    "vitest": "^1.5.0"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
