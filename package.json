{
  "name": "flash-mem",
  "version": "0.3.4",
  "license": "MIT",
  "description": "MCP Server for durable engineering memory in AI-assisted software development",
  "main": "dist/index.js",
  "bin": {
    "flash-mem": "dist/infrastructure/cli/index.js"
  },
  "files": [
    "dist",
    "docs/cli-reference.md",
    "docs/flash-mem-review-prompt.md",
    "docs/mcp-setup.md",
    "docs/releases.md",
    "docs/spec-kit-integration.md",
